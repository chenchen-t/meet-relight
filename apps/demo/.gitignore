!public/models/seg_post.tflite
!public/models/face_det_pre.tflite
!public/models/face_det_post.tflite
!public/models/face_lm_post.tflite
!public/models/face_landmarker/
public/models/face_landmarker/*
!public/models/face_landmarker/face_detector.tflite
!public/models/face_landmarker/face_landmarks_detector_b1.tflite
